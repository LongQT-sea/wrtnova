{
  "name": "wrtnova",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based OpenWrt firmware builder that bakes in the wrtnova.sh first-boot provisioning script.",
  "license": "MIT",
  "author": "LongQT-sea",
  "homepage": "https://github.com/LongQT-sea/wrtnova#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LongQT-sea/wrtnova.git"
  },
  "bugs": {
    "url": "https://github.com/LongQT-sea/wrtnova/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/style.css -o public/style.css --minify",
    "watch:css": "tailwindcss -i src/style.css -o public/style.css --watch",
    "embed": "node scripts/embed-wrtnova.mjs",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "check:no-zero": "node scripts/ci/check-no-zero.mjs",
    "check:marker": "node scripts/ci/check-marker.mjs",
    "check:no-dupes": "node scripts/ci/check-no-dupes.mjs",
    "check:budget": "node scripts/ci/check-budget.mjs",
    "check:i18n": "node scripts/ci/check-i18n-html.mjs",
    "check:i18n-locales": "node scripts/ci/check-i18n-locales.mjs",
    "check:i18n-diacritics": "node scripts/ci/check-i18n-diacritics.mjs",
    "ci": "npm run typecheck && npm test && npm run check:no-zero && npm run check:marker && npm run check:no-dupes && npm run check:budget && npm run check:i18n && npm run check:i18n-locales && npm run check:i18n-diacritics"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
