{
  "name": "wrtnova",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based OpenWrt firmware builder that bakes in the wrtnova.sh first-boot provisioning script.",
  "license": "MIT",
  "author": "LongQT-sea",
  "homepage": "https://github.com/LongQT-sea/wrtnova#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LongQT-sea/wrtnova.git"
  },
  "bugs": {
    "url": "https://github.com/LongQT-sea/wrtnova/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run embed",
    "preview": "vite preview",
    "embed": "node scripts/embed-wrtnova.mjs",
    "dev:pages": "npm run build && wrangler pages dev dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:screens": "playwright test --project=screens",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "bcryptjs": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^3.90.0"
  }
}
